<?xml version="1.0"?>
<!-- ################################ -->
<!-- XML: unified REMANI sim with robot_model switch begin -->
<!-- ################################ -->
<!-- Usage:
  # Ranger + CR10 (default)
  roslaunch remani_planner remani_sim.launch

  # Original FastArmer + small differential base
  roslaunch remani_planner remani_sim.launch robot_model:=fast_armer

  # Preset waypoints instead of manual 2D Nav Goal
  roslaunch remani_planner remani_sim.launch robot_model:=fast_armer target_type:=2
-->
<launch>
  <!-- robot_model: ranger_cr10 | fast_armer -->
  <arg name="robot_model" default="ranger_cr10"/>
  <arg name="mm_param_file" default="$(find remani_planner)/config/mm_param_$(arg robot_model).yaml"/>
  <arg name="exp_param_file" default="$(find remani_planner)/config/exp_$(arg robot_model)_param.yaml"/>
  <arg name="use_rviz" default="true"/>
  <arg name="target_type" default="1"/>

  <arg name="map_size_x" value="20.0"/>
  <arg name="map_size_y" value="8.0"/>
  <arg name="map_size_z" value="3.0"/>
  <arg name="map_resolution" value="0.05"/>
  <arg name="odom_topic" value="/mm/car/odom"/>
  <arg name="joint_state_topic" value="/mm/mani/joint_state"/>
  <arg name="joint_cmd_topic" value="/mm_controller_node/joint_cmd"/>
  <arg name="gripper_cmd_topic" value="/mm_controller_node/gripper_cmd"/>
  <arg name="gripper_state_topic" value="/mm/mani/gripper_state"/>

  <arg name="generate_map_size_x" default="16" if="$(eval arg('robot_model') == 'ranger_cr10')"/>
  <arg name="generate_map_size_y" default="12" if="$(eval arg('robot_model') == 'ranger_cr10')"/>
  <arg name="generate_map_size_z" default="3"  if="$(eval arg('robot_model') == 'ranger_cr10')"/>
  <arg name="min_turning_radius"  default="0.5" if="$(eval arg('robot_model') == 'ranger_cr10')"/>
  <arg name="pub_urdf_joint_states" default="true" if="$(eval arg('robot_model') == 'ranger_cr10')"/>

  <arg name="generate_map_size_x" default="8" if="$(eval arg('robot_model') == 'fast_armer')"/>
  <arg name="generate_map_size_y" default="8" if="$(eval arg('robot_model') == 'fast_armer')"/>
  <arg name="generate_map_size_z" default="3" if="$(eval arg('robot_model') == 'fast_armer')"/>
  <arg name="min_turning_radius"  default="0.2" if="$(eval arg('robot_model') == 'fast_armer')"/>
  <arg name="pub_urdf_joint_states" default="false" if="$(eval arg('robot_model') == 'fast_armer')"/>

  <param name="fsm/target_type" value="$(arg target_type)"/>
  <param name="search/min_turning_radius" value="$(arg min_turning_radius)"/>
  <!-- ################################ -->
  <!-- XML: Ranger needs longer Hybrid A* budget begin -->
  <!-- ################################ -->
  <param name="search/max_seach_time" value="2.0" if="$(eval arg('robot_model') == 'ranger_cr10')"/>
  <!-- ################################ -->
  <!-- XML: Ranger needs longer Hybrid A* budget end -->
  <!-- ################################ -->

  <group if="$(eval arg('robot_model') == 'ranger_cr10')">
    <!-- ################################ -->
    <!-- XML: URDF meshes as file:// (no rospack) begin -->
    <!-- ################################ -->
    <param name="robot_description"
           command="python3 $(find remani_planner)/scripts/urdf_package_to_file.py $(find rangerboxcr10lidar_description)/urdf/rangercr10lidar.urdf"/>
    <!-- ################################ -->
    <!-- XML: URDF meshes as file:// (no rospack) end -->
    <!-- ################################ -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
  </group>

  <include file="$(find remani_planner)/launch/advanced_param_sim.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="exp_param_file" value="$(arg exp_param_file)"/>
    <arg name="mm_param_file" value="$(arg mm_param_file)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>
    <arg name="joint_state_topic" value="$(arg joint_state_topic)"/>
    <arg name="joint_cmd_topic" value="$(arg joint_cmd_topic)"/>
    <arg name="gripper_cmd_topic" value="$(arg gripper_cmd_topic)"/>
    <arg name="gripper_state_topic" value="$(arg gripper_state_topic)"/>
    <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
    <arg name="depth_topic" value="pcl_render_node/depth"/>
    <arg name="cloud_topic" value="pcl_render_node/cloud"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
    <arg name="target_type" value="$(arg target_type)"/>
    <arg name="min_turning_radius" value="$(arg min_turning_radius)"/>
    <arg name="max_seach_time" value="2.0" if="$(eval arg('robot_model') == 'ranger_cr10')"/>
    <arg name="max_seach_time" value="0.5" if="$(eval arg('robot_model') == 'fast_armer')"/>
  </include>

  <include file="$(find remani_planner)/launch/simulator.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="exp_param_file" value="$(arg exp_param_file)"/>
    <arg name="mm_param_file" value="$(arg mm_param_file)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>
    <arg name="joint_state_topic" value="$(arg joint_state_topic)"/>
    <arg name="joint_cmd_topic" value="$(arg joint_cmd_topic)"/>
    <arg name="gripper_cmd_topic" value="$(arg gripper_cmd_topic)"/>
    <arg name="gripper_state_topic" value="$(arg gripper_state_topic)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="pub_urdf_joint_states" value="$(arg pub_urdf_joint_states)"/>
  </include>

  <!-- map: separate nodes per model (params cannot nest group inside node) -->
  <group if="$(eval arg('robot_model') == 'ranger_cr10')">
    <node pkg="map_generator" name="map_generator" type="map_generator" output="screen">
      <rosparam file="$(arg mm_param_file)"/>
      <rosparam file="$(arg exp_param_file)"/>
      <param name="map/x_size" value="$(arg generate_map_size_x)"/>
      <param name="map/y_size" value="$(arg generate_map_size_y)"/>
      <param name="map/z_size" value="$(arg generate_map_size_z)"/>
      <param name="map/resolution" value="$(arg map_resolution)"/>
      <param name="map/seed" value="30"/>
      <param name="map/obs_num" value="4"/>
      <param name="map/float_obs_num" value="2"/>
      <param name="min_distance" value="2.5"/>
      <param name="clear_radius" value="3.0"/>
      <!-- corridor along x + bridge sites clear of random cuboids -->
      <rosparam param="clear_centers">[[-5.0, 0.0], [-2.5, 0.0], [0.0, 0.0], [2.5, 0.0], [5.0, 0.0], [2.5, -2.5]]</rosparam>
      <!-- ################################ -->
      <!-- XML: Ranger+CR10 bridges begin -->
      <!-- ################################ -->
      <!-- [x, y, depth_x, width_y, clearance_z]
           width_y=1.8 > Ranger 0.90; clearance_z=1.25 for chassis+tucked CR10 -->
      <rosparam param="bridges">
        [[0.0, 0.0, 1.0, 1.8, 1.25],
         [2.5, -2.5, 1.0, 1.8, 1.25]]
      </rosparam>
      <!-- ################################ -->
      <!-- XML: Ranger+CR10 bridges end -->
      <!-- ################################ -->
      <param name="pub_rate" value="1.0"/>
    </node>
  </group>
  <group if="$(eval arg('robot_model') == 'fast_armer')">
    <node pkg="map_generator" name="map_generator" type="map_generator" output="screen">
      <rosparam file="$(arg mm_param_file)"/>
      <rosparam file="$(arg exp_param_file)"/>
      <param name="map/x_size" value="$(arg generate_map_size_x)"/>
      <param name="map/y_size" value="$(arg generate_map_size_y)"/>
      <param name="map/z_size" value="$(arg generate_map_size_z)"/>
      <param name="map/resolution" value="$(arg map_resolution)"/>
      <param name="map/seed" value="30"/>
      <param name="map/obs_num" value="20"/>
      <param name="map/float_obs_num" value="30"/>
      <param name="min_distance" value="1.2"/>
      <param name="clear_radius" value="1.5"/>
      <rosparam param="clear_centers">[[-3.0, 0.0], [3.0, 1.5], [-0.5, -3.0]]</rosparam>
      <param name="pub_rate" value="1.0"/>
    </node>
  </group>

  <group if="$(arg use_rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find remani_planner)/launch/remani_ranger_cr10.rviz"
          if="$(eval arg('robot_model') == 'ranger_cr10')"/>
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find remani_planner)/launch/exp0.rviz"
          if="$(eval arg('robot_model') == 'fast_armer')"/>
  </group>
</launch>
<!-- ################################ -->
<!-- XML: unified REMANI sim with robot_model switch end -->
<!-- ################################ -->
