<?xml version="1.0"?>
<!-- ################################ -->
<!-- XML: RoboSense lidar without local RViz begin -->
<!-- ################################ -->
<!-- Robot host: avoids spawning RViz on the AGX box. Config comes from
     rslidar_sdk/config/config.yaml (RSHELIOS_16P → /rslidar_points). -->
<launch>
  <node pkg="rslidar_sdk" name="rslidar_sdk_node" type="rslidar_sdk_node" output="screen">
    <param name="config_path" value=""/>
  </node>
</launch>
<!-- ################################ -->
<!-- XML: RoboSense lidar without local RViz end -->
<!-- ################################ -->
